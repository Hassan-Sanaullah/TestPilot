# Copy to .env and fill in. Everything is read at startup by packages/server.

# ============ LLM — choose free or paid ============
# free   -> Gemini Flash-Lite for per-step generation, Groq for reasoning (coverage, gaps, bug reports)
# openai -> OpenAI (paid) for everything
LLM_PROFILE=free

# Per-role override (optional): gemini | groq | openai | mock
# LLM_STEP_PROVIDER=gemini
# LLM_REASON_PROVIDER=groq

# Each provider has two models: *_MODEL for the high-volume per-step generation
# and *_REASON_MODEL (optional) for the few reasoning calls — coverage, gap
# generation, bug reports. The reasoning model falls back to *_MODEL if its
# (usually smaller) free quota runs out.

# --- Google AI Studio (free, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASON_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASON_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_REASON_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Thinking budget for per-step decisions: minimal | low | medium | high.
# "minimal" is ~2.5x faster on Gemini 3.x and costs no accuracy, because the
# action schema and validator already constrain the answer. Reasoning calls
# (coverage, missing tests, bug reports) always use the model's default.
LLM_STEP_EFFORT=minimal

# Minimum gap between calls per provider (ms). 0 = no artificial delay; each
# provider backs off automatically when it is actually rate-limited. Raise only
# if you keep hitting 429s.
LLM_MIN_INTERVAL_GEMINI_MS=0
LLM_MIN_INTERVAL_GROQ_MS=0
LLM_MIN_INTERVAL_OPENAI_MS=0
# Serve identical prompts from the response cache before calling the API (1 = on)
LLM_CACHE_FIRST=0

# ============ Server ============
PORT=4000
# Leave this unset unless you mean to move the database. The server computes an
# absolute path under packages/server/data; a RELATIVE path here resolves
# against whatever directory the process happened to start in, which silently
# creates a second, empty database.
# DATABASE_URL="file:/absolute/path/to/testpilot.db"
# 1 = run Chromium headless (no window). Default shows the browser so you can watch tests.
HEADLESS=0
# Hard cap on steps per run (safety net in addition to the per-project LLM call budget)
MAX_STEPS=30

# ---- How many runs at once --------------------------------------------------
# Most of a test run is a browser waiting for the network, so running several at
# once is close to free. A project with a reset hook still runs one test at a
# time, because the hook wipes the data the others are using.
RUN_CONCURRENCY=4
# Of those, how many may be AI-authoring runs. They share one free-tier quota,
# so this is lower than the total on purpose.
AI_CONCURRENCY=2

# ---- Evidence ---------------------------------------------------------------
# Playwright traces are large and slow to write, and a trace of a passing
# replay is almost never opened: always | on-failure | off.
# An AI authoring run always keeps its trace unless this is "off" — that is the
# one people actually open.
TRACE=on-failure
# Delete screenshots and traces older than this many days. Evidence behind an
# OPEN bug report is never deleted. 0 keeps everything.
EVIDENCE_KEEP_DAYS=30

# ---- The demo shop ----------------------------------------------------------
# Which of the five seeded defects are live: "1,3,5", "none", or "all".
# Unset means all five. "none" gives a correct shop, which is what the
# evaluation needs in order to measure false alarms.
# SHOP_BUGS=all
