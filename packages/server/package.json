{
  "name": "@testpilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "db:setup": "node scripts/prisma.mjs migrate deploy && node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:studio": "node scripts/prisma.mjs studio",
    "explore": "tsx scripts/explore.mts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "tsx scripts/bench.mts",
    "suite": "tsx scripts/suite.mts",
    "evaluate": "tsx scripts/evaluate.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@testpilot/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "playwright": "^1.50.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testpilot/demo-shop": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
